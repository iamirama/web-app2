{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3ae85b78-f085-4a1a-9729-4b2414fbe775","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9a6bebf90b6a4dd5852c4bede2f4cb7c" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "myiran.ghaem-ferforge.ir", "custom_domain": true }
  ],
  "build": {
    "command": "npm install && npm run build"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
